    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "anthropicApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model: $json.modelo, max_tokens: $json.max_tokens, system: $json.system_prompt, tools: [{\n \"name\": \"clasificar_lead\",\n \"description\": \"Registra la clasificación del lead y el borrador de respuesta para revisión humana.\",\n \"input_schema\": {\n  \"type\": \"object\",\n  \"properties\": {\n   \"categoria\": {\n    \"type\": \"string\",\n    \"enum\": [\n     \"VIP\",\n     \"Estandar\",\n     \"Descartar\"\n    ]\n   },\n   \"puntaje\": {\n    \"type\": \"integer\",\n    \"minimum\": 0,\n    \"maximum\": 100\n   },\n   \"urgencia\": {\n    \"type\": \"string\",\n    \"enum\": [\n     \"alta\",\n     \"media\",\n     \"baja\"\n    ]\n   },\n   \"servicio_interes\": {\n    \"type\": \"string\"\n   },\n   \"resumen\": {\n    \"type\": \"string\",\n    \"description\": \"Resumen de la consulta en máximo 2 frases.\"\n   },\n   \"motivo\": {\n    \"type\": \"string\",\n    \"description\": \"Justificación breve de la categoría y el puntaje.\"\n   },\n   \"asunto_respuesta\": {\n    \"type\": \"string\"\n   },\n   \"borrador_respuesta\": {\n    \"type\": \"string\",\n    \"description\": \"Texto del email. Vacío si la categoría es Descartar.\"\n   }\n  },\n  \"required\": [\n   \"categoria\",\n   \"puntaje\",\n   \"urgencia\",\n   \"servicio_interes\",\n   \"resumen\",\n   \"motivo\",\n   \"asunto_respuesta\",\n   \"borrador_respuesta\"\n  ]\n }\n}], messages: [{role: 'user', content: $json.user_prompt}]}) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "5de555fa-3df6-4c03-a783-779d7c3badc2",
      "name": "HTTP - Claude Clasificar y Redactar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        128
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "credentials": {
        "anthropicApi": {
          "id": "zY3oF4mUoRbPm2vZ",
          "name": "Anthropic account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst bloque = (r.content || []).find(b => b.type === 'tool_use');\nif (!bloque) throw new Error('La IA no devolvió el bloque tool_use esperado. stop_reason=' + r.stop_reason);\nconst d = bloque.input;\nif (r.stop_reason === 'max_tokens') throw new Error('La respuesta de la IA se cortó por max_tokens');\nif (d.categoria !== 'Descartar' && !d.borrador_respuesta) throw new Error('La IA no devolvió borrador_respuesta');\nconst categorias = ['VIP', 'Estandar', 'Descartar'];\nconst puntaje = Number(d.puntaje);\nif (!categorias.includes(d.categoria)) throw new Error('Categoría inválida: ' + d.categoria);\nif (!Number.isFinite(puntaje)) throw new Error('Puntaje no numérico: ' + d.puntaje);\nconst cfg = $('Set - Config y Parámetros').first().json;\nreturn [{ json: {\n  lead_id: $('Airtable - Crear Lead (Pendiente)').first().json.records[0].id,\n  nombre: cfg.nombre, email: cfg.email, empresa: cfg.empresa,\n  categoria: d.categoria, puntaje: puntaje, urgencia: d.urgencia,\n  servicio_interes: d.servicio_interes, resumen: d.resumen, motivo: d.motivo,\n  asunto_respuesta: d.asunto_respuesta, borrador_respuesta: d.borrador_respuesta,\n  tokens_entrada: r.usage?.input_tokens ?? null, tokens_salida: r.usage?.output_tokens ?? null\n}}];"
      },
      "id": "eed8889e-37e3-41ab-9b62-285402750b8f",
